{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      ".git/**",
      ".vs/**",
      "functions/**",
      "api/**",
      "paytr-notifications/**"
    ],
    "rewrites": [
      {
        "source": "/api/paytr-create-token",
        "function": {
          "functionId": "createPaytrToken",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/paytr-callback",
        "function": {
          "functionId": "paytrCallback",
          "region": "europe-west1"
        }
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions"
  }
}
