rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email in ["quaoratr@gmail.com", "sayedarman1352@gmail.com", "250508501@st.atlas.edu.tr"];
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isProductCollection(collectionName) {
      return collectionName in [
        "ayakkabilar",
        "bikini-altlari",
        "bikini_ustleri",
        "bottom_products",
        "cantalar",
        "conquette",
        "gozlukler",
        "mayokini_altlari",
        "mayokini_ustleri",
        "mayolar",
        "OUTLET",
        "PANZER",
        "pareolar",
        "PIE",
        "RELOVE",
        "sapkalar",
        "takilar",
        "tops_products",
        "yeni_gelenler"
      ];
    }

    match /users/{userId} {
      allow create, update: if isOwner(userId) || isAdmin();
      allow read: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow update, delete: if isAdmin();
    }

    match /refund_requests/{requestId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow update, delete: if isAdmin();
    }

    match /page_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /mail/{mailId} {
      allow create: if isAdmin();
      allow read, update, delete: if false;
    }

    match /discount_codes/{codeId} {
      allow read: if true;
      allow create: if isAdmin()
        || (
          signedIn()
          && codeId.matches('^[0-9]{6}$')
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.source == "welcome"
          && request.resource.data.type == "percent"
          && request.resource.data.value > 0
          && request.resource.data.value <= 100
          && request.resource.data.active == true
          && request.resource.data.maxUses == 1
          && request.resource.data.usedCount == 0
        );
      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.active == true
          && (!resource.data.keys().hasAny(['ownerUid']) || resource.data.ownerUid == request.auth.uid)
          && resource.data.usedBy[request.auth.uid] != true
          && (resource.data.maxUses == 0 || resource.data.usedCount < resource.data.maxUses)
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['usedBy', 'usedCount', 'updatedAt'])
          && request.resource.data.usedBy[request.auth.uid] == true
          && request.resource.data.usedCount == resource.data.usedCount + 1
        );
      allow delete: if isAdmin();
    }

    match /slider_images/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{collectionName}/{docId} {
      allow read: if isProductCollection(collectionName);
      allow write: if isAdmin() && isProductCollection(collectionName);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
