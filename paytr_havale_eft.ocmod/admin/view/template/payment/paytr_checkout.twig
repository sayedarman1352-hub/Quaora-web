{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-payment" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="alert alert-info">{{ help_callback }}</div>
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_settings }}</div>
      <div class="card-body">
        <form id="form-payment" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <ul class="nav nav-tabs">
            <li class="nav-item"><a href="#tab-general" data-bs-toggle="tab" class="nav-link active">{{ text_general }}</a></li>
            <li class="nav-item"><a href="#tab-order-status" data-bs-toggle="tab" class="nav-link">{{ text_order_status }}</a></li>
          </ul>
          <div class="tab-content">
            <div id="tab-general" class="tab-pane active">
              <div class="row mb-3 required">
                <label class="col-sm-2 col-form-label">{{ entry_merchant_id }}</label>
                <div class="col-sm-10"><input type="text" name="payment_paytr_checkout_merchant_id" value="{{ payment_paytr_checkout_merchant_id }}" class="form-control" /></div>
              </div>
              <div class="row mb-3 required">
                <label class="col-sm-2 col-form-label">{{ entry_merchant_key }}</label>
                <div class="col-sm-10"><input type="text" name="payment_paytr_checkout_merchant_key" value="{{ payment_paytr_checkout_merchant_key }}" class="form-control" /></div>
              </div>
              <div class="row mb-3 required">
                <label class="col-sm-2 col-form-label">{{ entry_merchant_salt }}</label>
                <div class="col-sm-10"><input type="text" name="payment_paytr_checkout_merchant_salt" value="{{ payment_paytr_checkout_merchant_salt }}" class="form-control" /></div>
              </div>
              <div class="row mb-3">
                <label class="col-sm-2 col-form-label">{{ entry_test_mode }}</label>
                <div class="col-sm-10">
                  <select name="payment_paytr_checkout_test_mode" class="form-select">
                    <option value="1" {% if payment_paytr_checkout_test_mode == 1 %}selected{% endif %}>{{ entry_test_mode_on }}</option>
                    <option value="0" {% if payment_paytr_checkout_test_mode == 0 %}selected{% endif %}>{{ entry_test_mode_off }}</option>
                  </select>
                </div>
              </div>
              <div class="row mb-3">
                <label class="col-sm-2 col-form-label">{{ entry_installment_number }}</label>
                <div class="col-sm-10">
                  <select name="payment_paytr_checkout_installment_number" class="form-select">
                    {% for key, option in installment_options %}
                      <option value="{{ key }}" {% if key == payment_paytr_checkout_installment_number %}selected{% endif %}>{{ option }}</option>
                    {% endfor %}
                  </select>
                </div>
              </div>
              {% for field, label in {'iframe_v2': entry_iframe_v2, 'iframe_v2_dark': entry_iframe_v2_dark, 'status': entry_status} %}
              <div class="row mb-3">
                <label class="col-sm-2 col-form-label">{{ label }}</label>
                <div class="col-sm-10">
                  <select name="payment_paytr_checkout_{{ field }}" class="form-select">
                    <option value="1" {% if attribute(_context, 'payment_paytr_checkout_' ~ field) == 1 %}selected{% endif %}>{{ text_enabled }}</option>
                    <option value="0" {% if attribute(_context, 'payment_paytr_checkout_' ~ field) == 0 %}selected{% endif %}>{{ text_disabled }}</option>
                  </select>
                </div>
              </div>
              {% endfor %}
              <div class="row mb-3">
                <label class="col-sm-2 col-form-label"><span data-bs-toggle="tooltip" title="{{ help_total }}">{{ entry_total }}</span></label>
                <div class="col-sm-10"><input type="text" name="payment_paytr_checkout_total" value="{{ payment_paytr_checkout_total }}" class="form-control" /></div>
              </div>
              <div class="row mb-3">
                <label class="col-sm-2 col-form-label">{{ entry_sort_order }}</label>
                <div class="col-sm-10"><input type="text" name="payment_paytr_checkout_sort_order" value="{{ payment_paytr_checkout_sort_order }}" class="form-control" /></div>
              </div>
            </div>
            <div id="tab-order-status" class="tab-pane">
              {% for field, label in {'order_completed_id': entry_payment_complete, 'order_canceled_id': entry_payment_failed} %}
              <div class="row mb-3">
                <label class="col-sm-2 col-form-label">{{ label }}</label>
                <div class="col-sm-10">
                  <select name="payment_paytr_checkout_{{ field }}" class="form-select">
                    {% for order_status in order_statuses %}
                      <option value="{{ order_status.order_status_id }}" {% if order_status.order_status_id == attribute(_context, 'payment_paytr_checkout_' ~ field) %}selected{% endif %}>{{ order_status.name }}</option>
                    {% endfor %}
                  </select>
                </div>
              </div>
              {% endfor %}
              <div class="row mb-3">
                <label class="col-sm-2 col-form-label"><span data-bs-toggle="tooltip" title="{{ help_notify }}">{{ entry_notify_status }}</span></label>
                <div class="col-sm-10">
                  <select name="payment_paytr_checkout_notify" class="form-select">
                    <option value="1" {% if payment_paytr_checkout_notify == 1 %}selected{% endif %}>{{ text_enabled }}</option>
                    <option value="0" {% if payment_paytr_checkout_notify == 0 %}selected{% endif %}>{{ text_disabled }}</option>
                  </select>
                </div>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
