<div class="d-inline-block pt-2 pd-2 w-100">
  <div class="float-end">
    <button type="button" id="button-confirm" class="btn btn-primary">{{ button_confirm }}</button>
  </div>
</div>

<script type="text/javascript"><!--
$('#button-confirm').on('click', function () {
  var $btn = $(this);
  $.ajax({
    url: 'index.php?route=extension/paytr_havale_eft/payment/paytr_checkout.confirm',
    dataType: 'json',
    beforeSend: function () {
      $btn.prop('disabled', true).text('{{ text_loading }}');
    },
    complete: function () {
      $btn.prop('disabled', false).text('{{ button_confirm }}');
    },
    success: function (json) {
      if (json['error']) {
        alert(json['error']);
      }
      if (json['redirect']) {
        location = json['redirect'];
      }
    },
    error: function (xhr, ajaxOptions, thrownError) {
      alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
    }
  });
});
//--></script>
